# Shared secret shown on the /consent page when a client connects via OAuth.
BRIDGE_TOKEN=change-me-to-a-long-random-string

# Bind address for the HTTP server
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8792

# Public base URL clients use (tunnel hostname in production).
# Must match what Claude.ai / Grok Bot will call (no trailing slash).
BRIDGE_PUBLIC_URL=https://your-tunnel.example.com

# Optional: SQLite path (default: data/bridge.db)
# BRIDGE_DB_PATH=data/bridge.db
