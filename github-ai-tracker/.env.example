# GitHub token (classic PAT, no scopes needed for public activity) — raises
# the rate limit from 60 to 5000 req/hour. Get one at https://github.com/settings/tokens
GITHUB_TOKEN=

# Anthropic API key — enables the AI-expert commentary on each event.
# Without it, the tracker still runs and logs raw events, just no insight.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Protects POST/DELETE endpoints (adding/removing tracked users, manual poll).
# Leave unset for local/dev use only.
API_KEY=

# Optional: POST each new event as JSON (Slack-compatible `text` field included)
# to this URL — e.g. a Slack incoming webhook or Discord webhook.
WEBHOOK_URL=

# How often to poll each tracked user, in minutes.
POLL_INTERVAL_MINUTES=10

PORT=3000
